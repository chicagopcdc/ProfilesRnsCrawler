# Copy to fuseki.env (gitignored), then run:
#   python3 LoadToFuseki.py rdf/uchicago

# Fuseki base URL
FUSEKI_BASE_URL=http://localhost:3030

# Dataset name (the path segment after the base URL, e.g. /JULIAN)
FUSEKI_DATASET=JULIAN

# Named graph URI to load into (optional — omit to load into the default graph)
# FUSEKI_GRAPH=http://example.org/my-graph

# Fuseki credentials (required when auth is enabled)
FUSEKI_USERNAME=pipeline
FUSEKI_PASSWORD=
